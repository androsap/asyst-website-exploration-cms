# ───────────── Database (MySQL 8 / MariaDB 10.4+) ─────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE   (tambahkan ?ssl=true untuk koneksi TLS di cloud)
# Database WAJIB memakai charset utf8mb4 + collation utf8mb4_unicode_ci (pencarian case-insensitive).
DATABASE_URL="mysql://asyst:PASSWORD@127.0.0.1:3306/asyst_cms"
# Dipakai Prisma CLI (migrate/studio/seed). Biasanya sama dengan DATABASE_URL.
DIRECT_URL="mysql://asyst:PASSWORD@127.0.0.1:3306/asyst_cms"
# Ukuran pool koneksi per instance aplikasi (default 5). Turunkan bila batas koneksi server MySQL kecil.
# DATABASE_POOL_MAX=5

# ───────────── Auth.js ─────────────
# Wajib. Buat dengan: npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Opsional di Vercel (trustHost aktif). Isi untuk server lain, mis. https://cms.asyst.co.id
# AUTH_URL="http://localhost:3000"

# ───────────── API publik ─────────────
# Origin yang boleh memanggil /api/public & /api/forms dari browser (pisahkan koma, tanpa slash akhir).
# Gunakan "*" untuk mengizinkan semua origin (tidak disarankan di production).
ALLOWED_ORIGINS="http://localhost:5173,https://www.asyst.co.id"
# Header cache CDN (detik): Cache-Control: public, s-maxage=<SMAXAGE>, stale-while-revalidate=<SWR>
PUBLIC_CACHE_SMAXAGE=60
PUBLIC_CACHE_SWR=600

# ───────────── Preview ─────────────
# URL website (asyst-web) untuk tombol "Preview di website". Kosongkan untuk menonaktifkan.
PREVIEW_URL="http://localhost:5173"
# Secret token preview (opsional; default memakai AUTH_SECRET).
# PREVIEW_SECRET=""

# ───────────── Upload (Vercel Blob) ─────────────
# Otomatis tersedia di Vercel setelah Blob store dihubungkan ke project.
# Bila kosong saat development, file disimpan ke public/uploads (fallback lokal).
BLOB_READ_WRITE_TOKEN=""

# ───────────── Seed ─────────────
SEED_ADMIN_EMAIL="admin@asyst.co.id"
SEED_ADMIN_PASSWORD="GantiPasswordIni123!"
SEED_ADMIN_NAME="Administrator"
# SEED_ADMIN_RESET_PASSWORD=true   → reset password admin yang sudah ada
# SEED_RESET=true                  → hapus semua konten lalu isi ulang contoh data
